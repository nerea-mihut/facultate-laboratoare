        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama Componentelor — Arhitectura Aplicației Salon &amp; Academie\n\nskinparam componentStyle uml2\nleft to right direction\n\npackage \&quot;Aplicația Desktop Java (salon)\&quot; {\n  [Main\\n&lt;&lt;component&gt;&gt;] as MainComp\n  \n  [Modul UI (salon.ui)\\n&lt;&lt;component&gt;&gt;\\nLoginFrame, RegisterFrame,\\nClientDashboard, AppointmentBookingPanel,\\nCourseBookingPanel] as UIComp\n  \n  [Modul Acces Date (salon.db)\\n&lt;&lt;component&gt;&gt;\\nDatabaseConnection] as DBComp\n}\n\npackage \&quot;Biblioteci &amp; Servicii Externe\&quot; {\n  [Java Swing &amp; FlatLaf\\n&lt;&lt;component&gt;&gt;] as SwingComp\n  [Driver MariaDB JDBC\\n&lt;&lt;component&gt;&gt;] as JDBCComp\n}\n\npackage \&quot;Persistență Date\&quot; {\n  database \&quot;Baza de Date MariaDB\\n(proiect_salon)\\n&lt;&lt;component&gt;&gt;\&quot; as MariaDB\n  folder \&quot;Sistem Fișiere Local\\n(documents/)\\n&lt;&lt;component&gt;&gt;\&quot; as FileStorage\n}\n\ninterface \&quot;IAutentificare &amp; Navigare\&quot; as IAuth\ninterface \&quot;IInterogareBD\&quot; as IDB\ninterface \&quot;IRandareGUI\&quot; as IGUI\ninterface \&quot;IConexiuneSQL\&quot; as ISQL\ninterface \&quot;IStocareDocumente\&quot; as IDocs\n\n&#39; Interfete oferite\nUIComp -up- IAuth\nDBComp -up- IDB\nSwingComp -up- IGUI\nJDBCComp -up- ISQL\nFileStorage -up- IDocs\n\n&#39; Dependentele si interfetele cerute\nMainComp ..&gt; IAuth : &lt;&lt;use&gt;&gt;\nUIComp ..&gt; IGUI : &lt;&lt;use&gt;&gt;\nUIComp ..&gt; IDB : &lt;&lt;use&gt;&gt;\nUIComp ..&gt; IDocs : &lt;&lt;use&gt;&gt;\\n(încărcare acte curs)\nDBComp ..&gt; ISQL : &lt;&lt;use&gt;&gt;\nJDBCComp ..&gt; MariaDB : TCP/IP (3306)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="G3mg62c5Cy6k1maKi8Qf-225">
